{
  "name": "olx-design-system",
  "version": "0.1.0",
  "description": "Design tokens and CSS components for the OLX Design System.",
  "type": "module",
  "main": "dist/tokens.js",
  "exports": {
    ".": "./dist/tokens.js",
    "./tokens.json": "./tokens/tokens.json",
    "./css/tokens.css": "./css/tokens.css",
    "./css/base.css": "./css/base.css",
    "./css/components.css": "./css/components.css",
    "./css/olx.css": "./css/olx.css"
  },
  "files": [
    "tokens",
    "css",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.mjs",
    "preview": "npx --yes serve .",
    "capture:live": "node scripts/capture.mjs live",
    "capture:maple": "node scripts/capture.mjs maple",
    "snapshot": "node scripts/snapshot-live.mjs",
    "fetch-fonts": "node scripts/fetch-fonts.mjs",
    "book": "echo 'Open http://localhost:6006/book/' && npx --yes serve -l 6006 .",
    "capture:site": "node scripts/capture-site.mjs",
    "capture:logged-in": "node scripts/capture-logged-in.mjs",
    "prototype": "node scripts/build-prototype.mjs && echo 'Open http://localhost:6006/prototype/' && npx --yes serve -l 6006 .",
    "build:publish": "node scripts/build-prototype.mjs && node scripts/extract-assets.mjs && node scripts/build-catalog.mjs && node scripts/build-publish.mjs",
    "assets": "node scripts/extract-assets.mjs",
    "import:kit": "node scripts/import-kit.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "verify:pixels": "node scripts/verify-pixels.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "simple-icons": "^16.34.0"
  }
}
